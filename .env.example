AWS_REGION=us-east-1
# Use a cross-region inference profile ID or model ID enabled in your account
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# Optional: managed Bedrock Knowledge Base and Guardrail
BEDROCK_KB_ID=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=1
# Scope
ALLOWED_NAMESPACES=apps,staging
PROTECTED_NAMESPACES=kube-system,kube-public,cert-manager,istio-system
MAX_STEPS_PER_PLAN=3
MAX_REPLICAS=20
MAX_SCALE_DELTA=5
MIN_CONFIDENCE=0.6
MAX_EVIDENCE_STEPS=10
# HIL (use a secret from AWS Secrets Manager / SSM in real deployments)
APPROVAL_HMAC_SECRET=change-me
APPROVAL_TTL_SECONDS=900
APPROVER=cli            # cli | file
# Paths
AUDIT_PATH=./audit/audit.jsonl
RUNBOOK_DIR=./runbooks
INDEX_PATH=./.kb/index.json
APPROVAL_DIR=./.approvals
